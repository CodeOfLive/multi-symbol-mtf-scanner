//
// Confluence Strategy (MA + RSI + MACD) — v1.1 (Toggles added)
//@version=6
strategy("v11 Confluence Strategy v1.1", 
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.15,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════
// FUNCTIONS
// ══════════════════════════════════════════════════════════════
ma_calc(float src, simple int len, simple string ma_type) =>
    float result = na
    if ma_type == "SMA"
        result := ta.sma(src, len)
    else if ma_type == "EMA"
        result := ta.ema(src, len)
    else if ma_type == "WMA"
        result := ta.wma(src, len)
    else if ma_type == "HMA"
        result := ta.hma(src, len)
    else if ma_type == "RMA"
        result := ta.rma(src, len)
    else if ma_type == "VWMA"
        result := ta.vwma(src, len)
    else if ma_type == "DEMA"
        e1 = ta.ema(src, len)
        result := 2 * e1 - ta.ema(e1, len)
    else if ma_type == "TMA"
        result := ta.sma(ta.sma(src, math.ceil(len / 2)), math.floor(len / 2) + 1)
    else if ma_type == "LSMA"
        result := 3 * ta.wma(src, len) - 2 * ta.sma(src, len)
    else if ma_type == "ZLEMA"
        int lag = int(len / 2)
        ema_data = src + src - src[lag]
        result := ta.ema(ema_data, len)
    else if ma_type == "TSF"
        lrc  = ta.linreg(src, len, 0)
        lrc1 = ta.linreg(src, len, 1)
        result := lrc + (lrc - lrc1)
    result

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════
grp_ma = "Moving Averages"
ma1_tf   = input.timeframe("5",  "MA1 TF", group=grp_ma)
ma1_len  = input.int(12, "MA1 Len", minval=1, group=grp_ma)
ma1_type = input.string("EMA", "MA1 Type", options=["SMA","EMA","WMA","HMA","RMA","VWMA","DEMA","TMA","LSMA","ZLEMA","TSF"], group=grp_ma)

ma2_tf   = input.timeframe("15", "MA2 TF", group=grp_ma)
ma2_len  = input.int(26, "MA2 Len", minval=1, group=grp_ma)
ma2_type = input.string("EMA", "MA2 Type", options=["SMA","EMA","WMA","HMA","RMA","VWMA","DEMA","TMA","LSMA","ZLEMA","TSF"], group=grp_ma)

grp_rsi = "RSI (Momentum)"
rsi_len        = input.int(14, "Length", group=grp_rsi)
rsi_bull_level = input.int(50, "Bull ≥", group=grp_rsi)
rsi_bear_level = input.int(50, "Bear ≤", group=grp_rsi)

grp_macd = "MACD (Momentum Change)"
macd_fast    = input.int(12, "Fast", group=grp_macd)
macd_slow    = input.int(26, "Slow", group=grp_macd)
macd_sig_len = input.int(9,  "Signal", group=grp_macd)

grp_sig = "Signal Logic"
strict_mode = input.bool(false, "Strict (3/3 required)", group=grp_sig)

grp_aski = "Risk Management"
sl_atr_len    = input.int(14, "ATR Length", group=grp_aski)
sl_atr_mult   = input.float(1.5, "SL Multiplier (R)", step=0.1, group=grp_aski)
sl_enabled    = input.bool(true, "Enable Stop Loss", group=grp_aski, inline="sl")
tp1_r         = input.float(1.0, "TP1 (R multiple)", step=0.5, group=grp_aski)
tp1_enabled   = input.bool(true, "Enable Take Profit", group=grp_aski, inline="tp")

// ══════════════════════════════════════════════════════════════
// INDICATOR CALCULATIONS
// ══════════════════════════════════════════════════════════════
ma1 = request.security(syminfo.tickerid, ma1_tf, ma_calc(close, ma1_len, ma1_type), ignore_invalid_symbol=true)
ma2 = request.security(syminfo.tickerid, ma2_tf, ma_calc(close, ma2_len, ma2_type), ignore_invalid_symbol=true)

plot(ma1, "MA1", color=color.purple, linewidth=2)
plot(ma2, "MA2", color=color.orange, linewidth=2)

// ══════════════════════════════════════════════════════════════
// CONFLUENCE LOGIC
// ══════════════════════════════════════════════════════════════
rsi = ta.rsi(close, rsi_len)
[macd_line, macd_sig, macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_sig_len)

cross_up = ta.crossover(ma1, ma2)
cross_dn = ta.crossunder(ma1, ma2)

// RSI and MACD checks
rsi_ok_up  = cross_up and rsi > rsi_bull_level
rsi_ok_dn  = cross_dn and rsi < rsi_bear_level

macd_ok_up = cross_up and macd_hist > 0
macd_ok_dn = cross_dn and macd_hist < 0

// Count confluence (2 out of 3, or 3 out of 3)
count_up = (rsi_ok_up ? 1 : 0) + (macd_ok_up ? 1 : 0)
count_dn = (rsi_ok_dn ? 1 : 0) + (macd_ok_dn ? 1 : 0)

// Signal validation based on strict mode
valid_up = strict_mode ? (count_up == 2) : (count_up >= 1)
valid_dn = strict_mode ? (count_dn == 2) : (count_dn >= 1)

// Final Entry Conditions
long_condition  = cross_up and valid_up
short_condition = cross_dn and valid_dn

// ══════════════════════════════════════════════════════════════
// TRADE EXECUTION (Long Only)
// ══════════════════════════════════════════════════════════════
var float v_entry = na
var float v_sl    = na
var float v_tp1   = na
var float v_r     = na

atr = ta.atr(sl_atr_len)

if long_condition and strategy.position_size == 0
    v_entry := close
    v_r     := atr * sl_atr_mult
    v_sl    := v_entry - v_r
    v_tp1   := v_entry + (v_r * tp1_r)
    strategy.entry("Long", strategy.long, comment="Entry")

// Şalterlere göre SL ve TP değerlerini ayarla
float final_sl = sl_enabled ? v_sl : na
float final_tp = tp1_enabled ? v_tp1 : na

if strategy.position_size > 0
    strategy.exit("Exit", from_entry="Long", limit=final_tp, stop=final_sl, comment="Exit")

if short_condition and strategy.position_size > 0
    strategy.close("Long", comment="Reverse")

if strategy.position_size == 0 and strategy.position_size[1] > 0
    v_entry := na
    v_sl    := na
    v_tp1   := na
    v_r     := na